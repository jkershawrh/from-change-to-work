{
  "name": "from-change-to-work-story",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:visual": "playwright test",
    "verify:offline": "node scripts/verify-offline.mjs",
    "check": "npm run test && npm run build && npm run verify:offline",
    "preview": "vite preview",
    "validate:blueprint": "node --experimental-strip-types scripts/validate-blueprint.ts demo-blueprint.yaml"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.54.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "8.3.3",
    "vitest": "4.1.12"
  }
}
